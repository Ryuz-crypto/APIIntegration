[Unit]
Description=Apply a verified DashboardAPI-EC release update
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/dashboardapi-ec/backend
ExecStart=/opt/dashboardapi-ec/venv/bin/python /opt/dashboardapi-ec/apply-update.py
PrivateTmp=true
ProtectHome=true
