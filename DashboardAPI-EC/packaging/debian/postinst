#!/bin/sh
set -eu

APP_USER=dashboardapi
APP_ROOT=/opt/dashboardapi-ec
CONFIG_DIR=/etc/dashboardapi-ec
DATA_DIR=/var/lib/dashboardapi-ec
ENV_FILE="$CONFIG_DIR/dashboardapi-ec.env"

if ! id "$APP_USER" >/dev/null 2>&1; then
    adduser --system --group --home "$DATA_DIR" --no-create-home "$APP_USER"
fi

install -d -o "$APP_USER" -g "$APP_USER" -m 0750 "$DATA_DIR" /var/lib/dashboardapi-ec-tls
install -d -o root -g "$APP_USER" -m 0750 "$CONFIG_DIR"

if [ ! -f "$ENV_FILE" ]; then
    SECRET_KEY=$(openssl rand -hex 32)
    cat >"$ENV_FILE" <<EOF
ENVIRONMENT=production
APP_VERSION=1.0.0
AUTO_CREATE_SCHEMA=false
PYTHONDONTWRITEBYTECODE=1
DATABASE_URL=postgresql+psycopg:///dashboardapi_ec
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
BACKEND_CORS_ORIGINS=http://localhost
SECRET_KEY=$SECRET_KEY
EOF
    chown "$APP_USER:$APP_USER" "$ENV_FILE"
    chmod 0640 "$ENV_FILE"
fi
if ! grep -q '^TLS_ADMIN_TOKEN=' "$ENV_FILE"; then
  printf '\nTLS_ADMIN_TOKEN=%s\n' "$(openssl rand -hex 32)" >> "$ENV_FILE"
fi
if ! grep -q '^TLS_ENABLED=' "$ENV_FILE"; then
  printf 'TLS_ENABLED=true\n' >> "$ENV_FILE"
fi
chown root:"$APP_USER" "$ENV_FILE"
chmod 0640 "$ENV_FILE"

systemctl start postgresql redis-server
if ! runuser -u postgres -- psql -tAc "SELECT 1 FROM pg_roles WHERE rolname='dashboardapi'" | grep -q 1; then
    runuser -u postgres -- createuser dashboardapi
fi
if ! runuser -u postgres -- psql -tAc "SELECT 1 FROM pg_database WHERE datname='dashboardapi_ec'" | grep -q 1; then
    runuser -u postgres -- createdb -O dashboardapi dashboardapi_ec
fi

python3 -m venv "$APP_ROOT/venv"
"$APP_ROOT/venv/bin/pip" install --no-index --find-links "$APP_ROOT/wheels" \
    --upgrade --force-reinstall dashboardapi-ec-backend==1.0.0

set -a
. "$ENV_FILE"
set +a
cd "$APP_ROOT/backend"
runuser -u "$APP_USER" -- "$APP_ROOT/venv/bin/alembic" upgrade head
runuser -u "$APP_USER" -- "$APP_ROOT/venv/bin/python" -c "from app.db.init_db import init_db; init_db()"

ln -sf /etc/nginx/sites-available/dashboardapi-ec /etc/nginx/sites-enabled/dashboardapi-ec
if [ -f /etc/nginx/sites-available/dashboardapi-ec.upgrade ]; then
  mv /etc/nginx/sites-available/dashboardapi-ec.upgrade /etc/nginx/sites-available/dashboardapi-ec
fi
if [ ! -f /etc/nginx/sites-available/dashboardapi-ec ]; then
  install -m 0644 "$APP_ROOT/nginx-http.conf" /etc/nginx/sites-available/dashboardapi-ec
fi
if ! grep -q 'include /opt/dashboardapi-ec/nginx-bootstrap.conf;' /etc/nginx/sites-available/dashboardapi-ec; then
  sed -i '1i include /opt/dashboardapi-ec/nginx-bootstrap.conf;' /etc/nginx/sites-available/dashboardapi-ec
fi
sed -i 's/proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;/proxy_set_header X-Forwarded-For $remote_addr;/' /etc/nginx/sites-available/dashboardapi-ec
rm -f /etc/nginx/sites-enabled/default
nginx -t
systemctl daemon-reload
systemctl enable --now postgresql redis-server dashboardapi-ec dashboardapi-ec-worker nginx
systemctl enable --now dashboardapi-ec-tls.timer
systemctl restart dashboardapi-ec dashboardapi-ec-worker
systemctl reload nginx

echo "DashboardAPI-EC está disponible en http://$(hostname -I 2>/dev/null | awk '{print $1}')/"
echo "Usa 'Conectar Orchestrator' para registrar cada entorno y su credencial cifrada."

exit 0
