#!/bin/sh
set -eu

if [ -r /etc/os-release ]; then
    . /etc/os-release
else
    echo "DashboardAPI-EC requires Ubuntu." >&2
    exit 1
fi

if [ "${ID:-}" != "ubuntu" ]; then
    echo "DashboardAPI-EC 1.0 is supported only on Ubuntu." >&2
    exit 1
fi

# Preserve the configuration when upgrading from the old package that owned it
# as an ordinary file. New packages leave the active configuration to postinst.
if [ -f /etc/nginx/sites-available/dashboardapi-ec ]; then
    cp -p /etc/nginx/sites-available/dashboardapi-ec /etc/nginx/sites-available/dashboardapi-ec.upgrade
fi
exit 0
