{
  "version": "9.3",
  "status": "supported",
  "api_root": "/gms/rest",
  "operations": {
    "orchestrator.version": {
      "method": "GET",
      "path": "/gmsserver/briefInfo",
      "polling_hint_seconds": 600,
      "notes": [
        "Detects the running Orchestrator release."
      ]
    },
    "orchestrator.inventory.summary": {
      "method": "GET",
      "path": "/appliance",
      "polling_hint_seconds": 120,
      "notes": [
        "Managed EdgeConnect inventory with nePk identifiers (id field)."
      ]
    },
    "orchestrator.topology": {
      "method": "GET",
      "path": "/topology",
      "polling_hint_seconds": 300,
      "notes": [
        "Topology capability declared by the Orchestrator API."
      ]
    },
    "appliance.interfaces": {
      "method": "GET",
      "path": "/interfaceState/{appliance_id}?cached={cached}",
      "polling_hint_seconds": 60,
      "notes": [
        "Real HPE endpoint: per-appliance interface state."
      ]
    },
    "appliance.tunnels": {
      "method": "GET",
      "path": "/stats/aggregate/tunnel?nePk={appliance_id}&startTime={start_time}&endTime={end_time}&granularity={granularity}",
      "polling_hint_seconds": 60,
      "notes": [
        "Real HPE endpoint: aggregate tunnel stats for one appliance."
      ]
    },
    "appliance.performance": {
      "method": "GET",
      "path": "/stats/timeseries/appliance?nePk={appliance_id}&startTime={start_time}&endTime={end_time}&granularity={granularity}&trafficType={traffic_type}",
      "polling_hint_seconds": 60,
      "notes": [
        "Real HPE endpoint: timeseries appliance stats. Query params required."
      ]
    },
    "appliance.health": {
      "method": "POST",
      "path": "/health",
      "polling_hint_seconds": 60,
      "notes": [
        "Real HPE endpoint: loss/latency/jitter/MOS health summary per nePk."
      ]
    },
    "orchestrator.events": {
      "method": "GET",
      "path": "/event",
      "risk": "read",
      "notes": [
        "Recent Orchestrator events and alarms."
      ]
    },
    "appliance.event.history": {
      "method": "GET",
      "path": "/event2/appliance/{appliance_id}",
      "risk": "read",
      "path_params": [
        "appliance_id"
      ],
      "notes": [
        "Per-appliance event history."
      ]
    },
    "appliance.interface.set_admin_state": {
      "method": "PUT",
      "path": "/interfaceState/{appliance_id}/{interface_name}",
      "risk": "write",
      "path_params": [
        "appliance_id",
        "interface_name"
      ],
      "body_example": {
        "adminStatus": "up"
      },
      "notes": [
        "Set interface admin state (up/down) on an appliance."
      ]
    },
    "appliance.interface.set_description": {
      "method": "PUT",
      "path": "/interfaceConfig/{appliance_id}/{interface_name}",
      "risk": "write",
      "path_params": [
        "appliance_id",
        "interface_name"
      ],
      "body_example": {
        "description": "updated by MCP"
      },
      "notes": [
        "Update interface configuration such as description."
      ]
    },
    "appliance.suspend_traffic": {
      "method": "POST",
      "path": "/appliance/suspend/{appliance_id}",
      "risk": "write",
      "path_params": [
        "appliance_id"
      ],
      "body_example": {
        "suspend": true
      },
      "notes": [
        "Suspend or resume appliance traffic handling for failover tests."
      ]
    },
    "appliance.reboot": {
      "method": "POST",
      "path": "/appliance/reboot/{appliance_id}",
      "risk": "write",
      "path_params": [
        "appliance_id"
      ],
      "body_example": {},
      "notes": [
        "Reboot an appliance. Extremely disruptive; require explicit operator approval."
      ]
    },
    "policy_group.update": {
      "method": "PUT",
      "path": "/policyGroup/{group_id}",
      "risk": "write",
      "path_params": [
        "group_id"
      ],
      "body_example": {
        "name": "default-group"
      },
      "notes": [
        "Update a policy group used for steering overrides."
      ]
    },
    "appliance.tag.assign": {
      "method": "POST",
      "path": "/appliance/{appliance_id}/tags",
      "risk": "write",
      "path_params": [
        "appliance_id"
      ],
      "body_example": {
        "tags": [
          "failover-test"
        ]
      },
      "notes": [
        "Assign tags to an appliance to drive steering/policy overrides."
      ]
    },
    "appliance.send_command": {
      "method": "POST",
      "path": "/appliance/restInvoke/{appliance_id}",
      "risk": "write",
      "path_params": [
        "appliance_id"
      ],
      "body_example": {
        "cli": "show version"
      },
      "notes": [
        "Proxy an ECOS CLI command through the Orchestrator appliance REST gateway."
      ]
    }
  }
}
