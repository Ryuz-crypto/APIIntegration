# EdgeConnect Orchestrator (REST)
EC_ORCHESTRATOR_URL=https://orchestrator.example.com
# Opción 1: API key
EC_ORCHESTRATOR_API_KEY=
# Opción 2: usuario/contraseña
EC_ORCHESTRATOR_USER=
EC_ORCHESTRATOR_PASSWORD=
EC_VERIFY_TLS=true

# Appliances EdgeConnect (SSH, comandos ECOS)
# Credenciales comunes para todos los appliances.
EC_SSH_ENABLED=false
# Opcional: host/IP por defecto (vacio = se descubre desde el Orchestrator
# por nePk, nombre, IP o serial en cada consulta SSH)
EC_SSH_HOST=
EC_SSH_USER=admin
EC_SSH_PASSWORD=
# Password de enable (comun para todos; se envia automaticamente tras el login)
EC_SSH_ENABLE_PASSWORD=
EC_SSH_PORT=22
# auto = password first, then keyboard-interactive; use keyboard-interactive for appliances that reject password auth
EC_SSH_AUTH_METHOD=auto

# Seguridad
EC_ALLOW_WRITE_TOOLS=false
# Operaciones peligrosas (reboot/suspend/delete/...): nivel aparte, off por defecto
EC_ALLOW_DANGEROUS_WRITES=false
# Límite de escrituras por minuto
EC_MAX_WRITES_PER_MINUTE=10
EC_MAX_OUTPUT_CHARS=12000

# Identidad de build (opcional para wheels/containers sin .git)
# Si se omite, ec-mcp intenta resolver HEAD desde el checkout local.
EC_MCP_BUILD_COMMIT=

# Auditoría
EC_MCP_AUDIT_LOG=logs/mcp-audit.jsonl

# Transporte HTTP/SSE (ec-mcp http / ec-mcp sse)
# Mínimo 32 bytes aleatorios: python -c "import secrets; print(secrets.token_urlsafe(32))"
EC_MCP_AUTH_TOKEN=
EC_MCP_HOST=127.0.0.1
EC_MCP_PORT=8000
# Dominio(s) públicos publicados por el reverse proxy (separados por coma). Requerido detrás de nginx/ZTNA para evitar 421 del SDK
EC_MCP_ALLOWED_HOSTS=
# Responder POSTs con JSON plano en vez de streams SSE (default: true).
# Evita una condición de carrera del SDK detrás de proxies/túneles que cierran
# conexiones keep-alive inactivas (p.ej. sesiones que mueren tras el initialize).
EC_MCP_JSON_RESPONSE=true
