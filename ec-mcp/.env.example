# ec-mcp 3.0.0b3 — configuración completa
# Copia este archivo a .env, protege sus permisos (chmod 600 .env) y no lo
# subas al repositorio.

# ---------------------------------------------------------------------------
# EdgeConnect Orchestrator
# ---------------------------------------------------------------------------
EC_ORCHESTRATOR_URL=https://orchestrator.example.com

# Método recomendado: API key. Si existe, tiene prioridad sobre usuario/password.
EC_ORCHESTRATOR_API_KEY=

# Método alternativo:
EC_ORCHESTRATOR_USER=
EC_ORCHESTRATOR_PASSWORD=

# true en producción. false solo para laboratorios con certificados no confiables.
EC_VERIFY_TLS=true

# ---------------------------------------------------------------------------
# SSH opcional a appliances
# run_show_api funciona por Orchestrator y NO necesita estas variables.
# ---------------------------------------------------------------------------
EC_SSH_ENABLED=false
# Vacío = resolver appliance desde el inventario del Orchestrator.
EC_SSH_HOST=
EC_SSH_USER=
EC_SSH_PASSWORD=
EC_SSH_ENABLE_PASSWORD=
EC_SSH_PORT=22
# auto | password | keyboard-interactive
EC_SSH_AUTH_METHOD=auto
# Límite de conexión, lectura por comando y reintentos para fallos transitorios.
EC_SSH_CONNECT_TIMEOUT=30
EC_SSH_COMMAND_TIMEOUT=30
EC_SSH_RETRIES=1
# ---------------------------------------------------------------------------
# Axis Security (SSE) - plataforma SSE de Axis Security
# Solo requiere el token de administracion (Bearer JWT).
# ---------------------------------------------------------------------------
EC_AXIS_ENABLED=false
# Token JWT de administracion para admin-api.axissecurity.com
EC_AXIS_ADMIN_TOKEN=
EC_AXIS_BASE_URL=https://admin-api.axissecurity.com
EC_AXIS_VERIFY_TLS=true
EC_AXIS_TIMEOUT=30

# ---------------------------------------------------------------------------
# Seguridad, límites y auditoría
# ---------------------------------------------------------------------------
EC_ALLOW_WRITE_TOOLS=false
EC_ALLOW_DANGEROUS_WRITES=false
EC_MAX_WRITES_PER_MINUTE=10
EC_MAX_OUTPUT_CHARS=12000
EC_API_CACHE_TTL=30
EC_MCP_AUDIT_LOG=logs/mcp-audit.jsonl
# Opcional: omite o deja vacío para usar los perfiles incluidos.
EC_MCP_PROFILES_DIR=

# ---------------------------------------------------------------------------
# Transporte MCP
# ---------------------------------------------------------------------------
# Ruta explícita al .env. Normalmente se omite porque el servidor descubre .env.
# EC_MCP_ENV_FILE=/etc/ec-mcp/env

# Obligatorio para HTTP/SSE; no se usa en stdio.
# Genera uno con:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
EC_MCP_AUTH_TOKEN=
EC_MCP_HOST=127.0.0.1
EC_MCP_PORT=8000
# Hosts públicos separados por coma. Incluye el puerto si llega en Host.
# Ejemplo: mcp.example.com,mcp.example.com:10001
EC_MCP_ALLOWED_HOSTS=
EC_MCP_JSON_RESPONSE=true
EC_MCP_STATELESS=false

# Identidad opcional para wheels/containers sin .git.
EC_MCP_BUILD_COMMIT=

# ---------------------------------------------------------------------------
# Panel administrativo opcional: ec-mcp admin
# ---------------------------------------------------------------------------
EC_ADMIN_HOST=127.0.0.1
EC_ADMIN_PORT=8080
EC_ADMIN_PASSWORD=
# Un login válido limpia inmediatamente el bloqueo temporal.
EC_ADMIN_LOGIN_MAX_FAILURES=5
EC_ADMIN_LOGIN_WINDOW_SECONDS=60
# Omite estas variables para usar .ec-admin-pass y .ec-admin.json en cwd.
# EC_ADMIN_PASSWORD_FILE=/var/lib/ec-mcp/.ec-admin-pass
# EC_ADMIN_STORE=/var/lib/ec-mcp/.ec-admin.json

# ---------------------------------------------------------------------------
# Updater web 3.0
# ---------------------------------------------------------------------------
# Permite que el panel consulte GitHub y programe una actualización validada.
EC_UPDATE_ALLOW_WEB=true
EC_UPDATE_REPOSITORY=Ryuz-crypto/APIIntegration
EC_UPDATE_BRANCH=main
# Para repositorios privados: usuario y token fine-grained con Contents: Read.
EC_UPDATE_GITHUB_USER=
EC_UPDATE_GITHUB_TOKEN=
# install_admin_service.sh completa estas rutas automáticamente.
EC_UPDATE_PROJECT_DIR=
EC_UPDATE_STATE_DIR=/var/lib/ec-mcp-update
EC_UPDATE_SERVICE_NAME=ec-mcp.service
EC_UPDATE_ADMIN_SERVICE_NAME=ec-mcp-admin.service
# ---------------------------------------------------------------------------
# Dashboard remoto (SSH -> Ubuntu) - despliega el dashboard NOC en un servidor
# ---------------------------------------------------------------------------
# El MCP genera el dashboard (EdgeConnect + Axis) y lo instala/publica en un
# servidor Ubuntu via SSH (instala nginx, sube index.html). Queda fijo y estable.
# Tambien configurable desde el panel web: Variables -> Dashboard remoto (SSH).
EC_DASHBOARD_REMOTE_ENABLED=false
EC_DASHBOARD_REMOTE_HOST=
EC_DASHBOARD_REMOTE_USER=
EC_DASHBOARD_REMOTE_PASSWORD=
# EC_DASHBOARD_REMOTE_PORT=22
# EC_DASHBOARD_REMOTE_KEY_PATH=
# Puerto HTTP del dashboard en el servidor remoto (default 8090).
# EC_DASHBOARD_PORT=8090
# Directorio del dashboard en el remoto.
# EC_DASHBOARD_DIR=/var/www/ec-mcp-dashboard
# Auto-refresh del HTML generado (segundos).
# EC_DASHBOARD_REFRESH_SECONDS=30
